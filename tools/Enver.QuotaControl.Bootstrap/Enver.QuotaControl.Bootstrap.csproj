<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../Enver.QuotaControl/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Enver.API/Enver.API.csproj" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.110.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Enver.QuotaControl.Bootstrap.Tests" />
  </ItemGroup>
</Project>
