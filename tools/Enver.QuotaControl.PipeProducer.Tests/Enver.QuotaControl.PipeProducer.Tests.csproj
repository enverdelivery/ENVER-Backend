<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../Enver.QuotaControl/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Enver.QuotaControl.PipeProducer/Enver.QuotaControl.PipeProducer.csproj" />
    <!-- Referencia al artefacto aceptado; nunca recompilar el proyecto CONTROL. -->
    <Reference Include="Enver.QuotaControl">
      <HintPath>../Enver.QuotaControl/bin/Release/net10.0/Enver.QuotaControl.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
