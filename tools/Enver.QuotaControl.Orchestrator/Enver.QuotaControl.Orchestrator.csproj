<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../Enver.QuotaControl/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Enver.QuotaControl.Orchestrator.Tests" />
    <Reference Include="Enver.QuotaControl.PipeProducer">
      <HintPath>../Enver.QuotaControl.PipeProducer/bin/Release/net10.0/Enver.QuotaControl.PipeProducer.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
