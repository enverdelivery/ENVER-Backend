[Unit]
Description=ENVER API - entrega runtime fijada y fail closed (arranque no autorizado)
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/enver/api-start.authorized

[Service]
Type=simple
User=root
Group=root
UMask=0077
LimitCORE=0
RuntimeDirectory=enver
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
# Solo referencia de imagen NO secreta; debe aprobarse en el siguiente gate.
EnvironmentFile=/etc/enver/api-image.env
ExecStartPre=/opt/enver/runtime-config/current/materialize.sh
ExecStart=/opt/enver/runtime-config/current/start-api.sh
ExecStop=-/usr/bin/docker stop --time 30 enver-api
ExecStopPost=-/usr/bin/docker rm enver-api
Restart=no
TimeoutStartSec=120
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
