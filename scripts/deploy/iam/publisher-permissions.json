{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "EcrAuthentication", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}},
    {"Sid": "OneRepositoryPublication", "Effect": "Allow", "Action": [
      "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload",
      "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:DescribeImages"
    ], "Resource": "arn:aws:ecr:us-east-1:926925605666:repository/enver-dev-api"}
  ]
}
