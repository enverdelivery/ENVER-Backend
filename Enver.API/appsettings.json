{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "DatabaseName": "",
    "UsersCollectionName": "users",
    "OperationTimeoutMilliseconds": 2000,
    "ConnectionTimeoutMilliseconds": 2000,
    "WriteConcernCandidate": "majority",
    "ReadConcernCandidate": "majority",
    "ReadPreference": "primary"
  },
  "Redis": {
    "NamespacePrefix": "",
    "RevocationPurpose": "auth:revocation",
    "RateLimitingPurpose": "auth:ratelimit",
    "OperationTimeoutMilliseconds": 750,
    "ConnectionTimeoutMilliseconds": 2000,
    "RevocationOperationalMarginSeconds": 60,
    "FailClosed": true,
    "RequiredRevocationEvictionPolicy": "noeviction"
  },
  "Jwt": {
    "Algorithm": "HS256",
    "Issuer": "enver-api",
    "Audience": "enver-mobile",
    "LifetimeSeconds": 900,
    "ClockSkewSeconds": 30,
    "ActiveKid": "",
    "Keys": []
  },
  "Authentication": {
    "InstitutionalDomain": "uttt.edu.mx",
    "FullNameMaxUnicodeScalars": 200,
    "EmailMaxAsciiBytes": 254,
    "EmailLocalPartMaxAsciiBytes": 64,
    "PasswordCreationMinUnicodeScalars": 12,
    "PasswordMaxUnicodeScalars": 128,
    "PasswordMaxUtf8Bytes": 512,
    "MaxRequestBodyBytes": 16384,
    "MaxJsonDepth": 4,
    "MaxJwtBytes": 4096,
    "RegisterBudgetMilliseconds": 8000,
    "LoginBudgetMilliseconds": 8000,
    "LogoutBudgetMilliseconds": 4000,
    "HashingConcurrencyLimit": 2
  },
  "RateLimiting": {
    "RegisterEmail": { "PermitLimit": 3, "WindowSeconds": 900 },
    "RegisterOrigin": { "PermitLimit": 20, "WindowSeconds": 900 },
    "LoginOriginEmail": { "PermitLimit": 5, "WindowSeconds": 60 },
    "LoginEmail": { "PermitLimit": 10, "WindowSeconds": 60 },
    "LoginOrigin": { "PermitLimit": 60, "WindowSeconds": 60 },
    "LogoutAccount": { "PermitLimit": 30, "WindowSeconds": 60 },
    "LogoutOrigin": { "PermitLimit": 300, "WindowSeconds": 60 },
    "PolicyRevision": "academic-initial",
    "MaxActivePartitions": null
  }
}
