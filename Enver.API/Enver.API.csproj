<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>504dc0ff-6b94-4735-ba9d-eb4aeca60fa0</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <PropertyGroup>
    <_LocalSensitiveFilePatterns>**/appsettings.Local.json;**/appsettings.*.Local.json;**/secrets.json;**/*.pfx;**/*.p12;**/*.pem;**/*.key;**/.env;**/.env.*;**/*.tfstate;**/*.tfstate.*;**/*.tfvars;**/*.tfvars.json;**/*.tfplan</_LocalSensitiveFilePatterns>
  </PropertyGroup>

  <!-- Conservar configuración base; nunca copiar archivos locales sensibles a output/publish. -->
  <ItemGroup>
    <Content Update="$(_LocalSensitiveFilePatterns)" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="$(_LocalSensitiveFilePatterns)" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
